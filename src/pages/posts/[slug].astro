---
export async function getStaticPaths() {
 const posts = await Astro.glob('../../content/posts/*.md');
 return posts.map(post => ({ params: { slug: post.file.split('/').pop().replace(/\.md$/, '') }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = post;
const base = import.meta.env.BASE_URL;
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={post.frontmatter.description}/><title>{post.frontmatter.title} · 知行之间</title><style>html{scroll-behavior:smooth}body{margin:0;background:#f7f7f2;color:#292d28;font-family:"PingFang SC",sans-serif}a{color:#547960;text-decoration:none}header{border-bottom:1px solid #dedfd8;padding:24px max(24px,calc((100vw - 1050px)/2));font-family:serif;font-weight:bold}main{max-width:720px;margin:75px auto;padding:0 24px}small{color:#788d79;letter-spacing:.1em}h1{font:600 clamp(34px,5vw,48px)/1.4 "Songti SC",serif;margin:22px 0} .desc{color:#858d84;line-height:1.8}.content{margin-top:48px;border-top:1px solid #dedfd8;padding-top:24px;font-size:16px;line-height:2.15}.content h2{font:600 26px serif;margin-top:52px}.content blockquote{margin:36px 0;padding:8px 24px;border-left:3px solid #91ab93;background:#edf1ea;color:#657b69}.back{display:inline-block;margin-top:45px;font-size:13px}footer{max-width:720px;margin:70px auto;padding:25px 24px;border-top:1px solid #dedfd8;color:#999;font-size:12px}</style></head><body><header><a href={base}>知行之间</a></header><main><small>{post.frontmatter.category}　 /　 {post.frontmatter.date}</small><h1>{post.frontmatter.title}</h1><p class="desc">{post.frontmatter.description}</p><article class="content"><Content /></article><a class="back" href={base}>← 返回首页</a></main><footer>© 2026 知行之间</footer></body></html>
