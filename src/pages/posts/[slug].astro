---
export async function getStaticPaths() {
 const posts = await Astro.glob('../../content/posts/*.md');
 return posts.map(post => ({ params: { slug: post.file.split('/').pop().replace(/\.md$/, '') }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = post;
const headings = post.getHeadings().filter(heading => heading.depth === 2);
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={post.frontmatter.description}/><title>{post.frontmatter.title} · 知行之间</title><style>html{scroll-behavior:smooth}body{margin:0;background:#f7f7f2;color:#292d28;font-family:"PingFang SC",sans-serif}a{color:#547960;text-decoration:none}header{border-bottom:1px solid #dedfd8;padding:24px max(24px,calc((100vw - 1050px)/2));font-family:serif;font-weight:bold}main{max-width:768px;margin:75px auto;padding:0 24px}.toc{position:fixed;z-index:20;right:0;top:112px}.toc details{position:relative;width:min(260px,calc(100vw - 28px));min-height:110px;transform:translateX(calc(100% - 42px));transition:transform .22s ease;background:#f7f7f2;border:1px solid #dce4d9;border-right:0;border-radius:8px 0 0 8px;box-shadow:0 4px 18px #263b2920}.toc details[open]{transform:translateX(0)}.toc summary{position:absolute;left:0;top:0;width:42px;min-height:108px;padding:13px 0;display:flex;align-items:center;justify-content:center;writing-mode:vertical-rl;font-size:13px;letter-spacing:.12em;color:#547960;cursor:pointer;user-select:none;list-style:none}.toc summary::-webkit-details-marker{display:none}.toc summary:before{content:"‹";font:20px sans-serif;writing-mode:horizontal-tb;margin-bottom:8px}.toc details[open] summary:before{content:"›"}.toc summary:focus-visible{outline:2px solid #66846b;outline-offset:-4px}.toc nav{margin-left:42px;border-left:1px solid #e2e8df;max-height:calc(100vh - 150px);overflow-y:auto;padding:8px 16px}.toc a{display:block;color:#66806c;font-size:12px;line-height:1.6;padding:9px 0}.toc a:hover{color:#304d37}@media(max-width:760px){main{margin:45px auto;padding:0 52px 0 20px}.toc{top:88px}.toc nav{max-height:calc(100vh - 125px)}}@media(prefers-reduced-motion:reduce){.toc details{transition:none}}small{color:#788d79;letter-spacing:.1em}h1{font:600 clamp(34px,5vw,48px)/1.4 "Songti SC",serif;margin:22px 0} .desc{color:#858d84;line-height:1.8}.content{margin-top:48px;border-top:1px solid #dedfd8;padding-top:24px;font-size:16px;line-height:2.15}.content h2{font:600 26px serif;margin-top:52px}.content blockquote{margin:36px 0;padding:8px 24px;border-left:3px solid #91ab93;background:#edf1ea;color:#657b69}.back{display:inline-block;margin-top:45px;font-size:13px}footer{max-width:720px;margin:70px auto;padding:25px 24px;border-top:1px solid #dedfd8;color:#999;font-size:12px}</style></head><body><header><a href={base}>知行之间</a></header><main><div><small>{post.frontmatter.category}　 /　 {post.frontmatter.date}</small><h1>{post.frontmatter.title}</h1><p class="desc">{post.frontmatter.description}</p><article class="content"><Content /></article><a class="back" href={`${base}topics/`}>← 返回专题</a></div><aside class="toc"><details><summary>本页目录</summary><nav aria-label="文章目录">{headings.map(heading => <a href={`#${heading.slug}`}>{heading.text}</a>)}</nav></details></aside></main><footer>© 2026 知行之间</footer></body></html>
