---
export async function getStaticPaths() {
 const posts = await Astro.glob('../../content/posts/*.md');
 return posts.map(post => ({ params: { slug: post.file.split('/').pop().replace(/\.md$/, '') }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = post;
const headings = post.getHeadings().filter(heading => heading.depth === 2 || heading.depth === 3);
const tocGroups = [];
for (const heading of headings) {
 if (heading.depth === 2) tocGroups.push({ heading, children: [] });
 else if (tocGroups.length) tocGroups[tocGroups.length - 1].children.push(heading);
 else tocGroups.push({ heading, children: [] });
}
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
