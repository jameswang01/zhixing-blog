---
const posts = (await Astro.glob('../../content/posts/*.md')).sort((a,b) => b.frontmatter.date.localeCompare(a.frontmatter.date));
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const javaDirections = [
 { id: 'fundamentals', title: 'Java 基础与并发', description: '集合、线程池、锁与并发工具' },
 { id: 'jvm', title: 'JVM 与诊断', description: '内存、垃圾回收与故障排查' },
 { id: 'mysql', title: '数据库', description: '事务、索引、MVCC 与慢 SQL' },
 { id: 'redis', title: '缓存与 Redis', description: '数据结构、缓存一致性与高可用' },
 { id: 'framework', title: '框架与中间件', description: 'Spring、MyBatis 与消息队列' },
 { id: 'distributed', title: '分布式与系统设计', description: '事务、分布式锁、RPC 与稳定性' },
 { id: 'network', title: '网络基础', description: 'HTTP、TCP、TLS 与身份认证' },
].map(item => ({ ...item, count: posts.filter(post => post.frontmatter.javaDirection === item.id).length }));
const categories = [{ id:'all', name:'全部文章' },{ id:'java', name:'Java 后端' },{ id:'agent', name:'Agent 与 AI' },{ id:'interview', name:'面试准备' },{ id:'notes', name:'工程随笔' }];
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>知识专题 · 知行之间</title><style>
:root{color:#272d28;background:#f7f7f2;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}*{box-sizing:border-box}body{margin:0}a{color:inherit;text-decoration:none}.wrap{max-width:1180px;padding:0 38px;margin:auto}.head{height:78px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #e0e5dc}.brand{font:700 19px Georgia,serif;letter-spacing:.08em}.brand i{font:normal 16px serif;display:inline-grid;place-items:center;background:#4b7458;color:#fff;width:32px;height:32px;margin-right:10px}.nav{display:flex;gap:32px;color:#717a70;font-size:13px}.active{color:#4b7458}.pagehead{padding:60px 0 30px}.eyebrow{font-size:10px;letter-spacing:.17em;color:#67866d;font-weight:700}.pagehead h1{font:600 38px 'Songti SC',serif;margin:14px 0}.pagehead p{font-size:14px;color:#89938a}.layout{display:grid;grid-template-columns:190px minmax(0,1fr);gap:45px;padding-bottom:70px}.sidebar{border-right:1px solid #e0e5dc;padding-right:20px}.sideheading{color:#a1aaa0;font-size:10px;letter-spacing:.12em;padding:12px}.sideitem{display:block;padding:12px;font-size:13px;color:#718075;border-radius:4px}.sideitem:hover,.sideitem.active{background:#eaf0e8;color:#527259}.contentbox{background:#fff;border:1px solid #ebeee8;padding:30px 38px}.contentbox h2{font:600 24px serif;margin:4px 0 12px}.description,.empty{color:#89938a;font-size:13px;line-height:1.9}.java-overview{margin:25px 0 28px}.java-overview-title{font:600 17px serif;color:#334c38;margin:0 0 5px}.java-overview-intro{font-size:12px;color:#8a988b;margin:0 0 16px}.java-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.java-card{display:block;border:1px solid #e5ece3;background:#f9fbf8;padding:16px 18px;border-radius:7px;transition:border-color .15s,background .15s}.java-card.selected,.java-card:hover{border-color:#aec6ae;background:#f0f6ee}.java-card strong{display:block;color:#35543b;font-size:14px;margin-bottom:6px}.java-card span{font-size:12px;color:#849487;line-height:1.6}.java-card b{float:right;color:#8ba48f;font-weight:400}.row{display:grid;grid-template-columns:100px 1fr auto;gap:22px;align-items:start;padding:23px 0;border-bottom:1px solid #e0e5dc}.row h3{font:600 18px serif;margin:0 0 8px}.row p,.date{font-size:12px;color:#929b92;margin:0}.pill{font-size:11px;color:#788c79;border:1px solid #dce7dc;padding:6px 9px;border-radius:15px}.foot{padding:26px 0;border-top:1px solid #e0e5dc;color:#a3aba2;font-size:11px;display:flex;justify-content:space-between}[hidden]{display:none!important}@media(max-width:700px){.wrap{padding:0 20px}.layout{grid-template-columns:1fr;gap:20px}.sidebar{display:flex;overflow:auto;border:0;padding:0}.sideheading{display:none}.sideitem{white-space:nowrap}.contentbox{padding:22px}.row{grid-template-columns:1fr;gap:9px}.java-grid{grid-template-columns:1fr}.nav{gap:10px;font-size:12px}}
</style></head><body><div class="wrap"><header class="head"><a class="brand" href={base}><i>知</i>知行之间</a><nav class="nav"><a href={base}>首页</a><a class="active" href={`${base}topics/`}>专题</a><a href={`${base}#about`}>关于</a></nav></header><main><div class="pagehead"><div class="eyebrow">THE KNOWLEDGE LIBRARY</div><h1>知识专题</h1><p>围绕问题建立知识，也在实践中不断修正。</p></div><div class="layout"><aside class="sidebar" aria-label="专题分类"><div class="sideheading">浏览专题</div>{categories.map(c=><a class:list={['sideitem',c.id==='all'&&'active']} href={`#${c.id}`} data-category={c.id}>{c.name}</a>)}</aside><section class="contentbox"><h2 id="category-title">全部文章</h2><p class="description">通过专题分类，找到感兴趣的内容。</p><div class="java-overview" id="java-overview" hidden><h3 class="java-overview-title">按方向开始复习</h3><p class="java-overview-intro">选择方向，查看该分类下的专题文章。</p><div class="java-grid">{javaDirections.map(item => <a class="java-card" data-direction-card={item.id} href={`#java-${item.id}`}><b>{item.count} 篇 ↗</b><strong>{item.title}</strong><span>{item.description}</span></a>)}</div></div>{posts.map(post=><a class="row" data-java-direction={post.frontmatter.javaDirection || ""} data-post-category={post.frontmatter.category === '写在开始' ? 'notes' : ({'Java 后端':'java','Agent 与 AI':'agent','面试准备':'interview','工程随笔':'notes'}[post.frontmatter.category] || 'notes')} href={`${base}posts/${post.file.split('/').pop().replace(/\.md$/, '')}/`}><span class="date">{post.frontmatter.date}</span><div><h3>{post.frontmatter.title}　↗</h3><p>{post.frontmatter.description}</p></div><span class="pill">{post.frontmatter.category}</span></a>)}<p class="empty" id="empty" hidden>这个专题还没有文章，敬请期待。</p></section></div></main><footer class="foot"><span>© 2026 知行之间</span><span>LEARN, BUILD, REFLECT.</span></footer></div><script>
const links=[...document.querySelectorAll('[data-category]')];const rows=[...document.querySelectorAll('[data-post-category]')];const cards=[...document.querySelectorAll('[data-direction-card]')];function update(){const id=location.hash.slice(1)||'all';const direction=id.startsWith('java-')?id.slice(5):'';const selected=links.find(x=>x.dataset.category===(direction?'java':id))||links[0];links.forEach(x=>x.classList.toggle('active',x===selected));cards.forEach(card=>card.classList.toggle('selected',card.dataset.directionCard===direction));document.getElementById('category-title').textContent=direction?(cards.find(card=>card.dataset.directionCard===direction)?.querySelector('strong')?.textContent||'Java 后端'):selected.textContent;document.getElementById('java-overview').hidden=selected.dataset.category!=='java';let count=0;rows.forEach(row=>{row.hidden=(selected.dataset.category!=='all'&&row.dataset.postCategory!==selected.dataset.category)||(!!direction&&row.dataset.javaDirection!==direction);if(!row.hidden)count++});document.getElementById('empty').hidden=count!==0}window.addEventListener('hashchange',update);update();
</script></body></html>
